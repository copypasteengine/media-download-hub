# Stable Compose project identity; keep unchanged after deployment.
COMPOSE_PROJECT_NAME=media-download-hub
# Host-level deployment parameters only. Accounts, categories and paths are configured in the web console.
# Use your LAN IP to allow other devices to access the service.
BIND_IP=127.0.0.1
WEB_PORT=9070
API_PORT=9071
ADMIN_PORT=9072
# Existing host directories. Relative paths are resolved next to compose.yaml.
MEDIA_ROOT=./downloads
# Container mount path and display name are customizable; they are unrelated to the project name.
DOWNLOADS_MOUNT=/downloads
STORAGE_NAME=下载存储
# For additional mounts, provide the same list to manager and queue (see README).
# STORAGE_ROOTS=[{"id":"main","name":"视频盘","path":"/downloads"},{"id":"archive","name":"归档盘","path":"/archive"}]
STATE_ROOT=./state
# Optional remote browser, not required for Cookie import or downloading.
# COMPOSE_PROFILES=browser-login
# BROWSER_LOGIN_ENABLED=true
